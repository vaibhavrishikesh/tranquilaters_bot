PMS_PROPERTY_ID=
PMS_BEARER_TOKEN=
PMS_API_KEY=
PMS_COOKIE=
PMS_USERNAME=
PMS_PASSWORD=
PMS_ENDPOINT_ROOMS=/room/property
PMS_ENDPOINT_INHOUSE=/bookingroom/inhouse
PMS_ENDPOINT_UPCOMING=/booking/upcoming
STATE_FILE=/var/lib/zimmerstack-bot/state.json
ROOMS_FILE=/var/lib/zimmerstack-bot/rooms.json
AUTH_FILE=/var/lib/zimmerstack-bot/auth.json
