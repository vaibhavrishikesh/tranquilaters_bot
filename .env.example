HERMES_TELEGRAM_BOT_TOKEN=
HERMES_ALLOWED_CHAT_IDS=
HERMES_ALLOWED_USER_IDS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
REQUEST_TIMEOUT_SECONDS=12
