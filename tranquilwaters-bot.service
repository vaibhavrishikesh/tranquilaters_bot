[Unit]
Description=TranquilWaters Hermes Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/tranquilwaters-bot.env
WorkingDirectory=/opt/tranquilwaters-bot
ExecStart=/usr/bin/python3 /opt/tranquilwaters-bot/tranquilwaters_bot.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
